<model>
    <mount>//OPNsense/terminal</mount>
    <version>0.1.0</version>
    <description>Web Terminal Configuration</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <default>1</default>
                <required>N</required>
            </enabled>
            <default_shell type="OptionField">
                <default>auto</default>
                <required>N</required>
                <OptionValues>
                    <auto>Auto (User's Login Shell)</auto>
                    <csh>/bin/csh (C Shell)</csh>
                    <sh>/bin/sh (Bourne Shell)</sh>
                    <bash>/usr/local/bin/bash (Bourne Again Shell)</bash>
                    <zsh>/usr/local/bin/zsh (Z Shell)</zsh>
                </OptionValues>
            </default_shell>
        </general>
    </items>
</model>
