# pkg trigger: rebuild the xcaddy binary when the caddy package changes.
#
# A caddy package upgrade replaces /usr/local/bin/caddy with a vanilla binary,
# silently dropping every module os-caddy added via xcaddy. pkg runs this
# trigger at the END of any transaction that installs, upgrades or removes a
# file under /usr/local/bin, so modules are restored immediately instead of
# waiting for a scheduled check.
#
# Note: only directory paths are supported — path_regexp and path_glob are
# not implemented in the pkg builds shipped with FreeBSD 15 (the trigger is
# silently skipped). A /usr/local/bin directory match is slightly broad (any
# binary update fires it), but ensure is a cheap fingerprint compare and a
# no-op when the caddy binary is unchanged.
path: "/usr/local/bin"
trigger: {
    type: lua
    sandbox: false
    script: <<EOS
pkg.exec({"/usr/local/bin/php", "/usr/local/opnsense/scripts/OPNsense/Caddy/modules.php", "ensure"})
EOS
}
