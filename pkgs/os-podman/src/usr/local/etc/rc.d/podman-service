#!/bin/sh

# PROVIDE: podman_service
# REQUIRE: DAEMON NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="podman_service"
rcvar="podman_service_enable"

load_rc_config "${name}"

: ${podman_service_enable:="NO"}
: ${podman_service_tcp_enable:="NO"}
: ${podman_service_listen_address:="127.0.0.1"}
: ${podman_service_listen_port:="2376"}
: ${podman_service_tls_enable:="NO"}
: ${podman_service_tls_cert:=""}
: ${podman_service_tls_key:=""}
: ${podman_service_tls_ca:=""}
: ${podman_service_socket_enable:="YES"}

pidfile="/var/run/podman/podman_service.pid"
tcppidfile="/var/run/podman/podman_service_tcp.pid"
logfile="/var/log/podman/system-service.log"
podman_bin="/usr/local/bin/podman"

# Construct TLS flags for TCP service
tls_flags=""
if [ "${podman_service_tls_enable}" = "YES" ]; then
    if [ -f "${podman_service_tls_cert}" ] && [ -f "${podman_service_tls_key}" ]; then
        tls_flags="--tls-cert=${podman_service_tls_cert} --tls-key=${podman_service_tls_key}"
        if [ -f "${podman_service_tls_ca}" ]; then
            tls_flags="${tls_flags} --tls-client-ca=${podman_service_tls_ca}"
        fi
    fi
fi

podman_service_prestart()
{
    /usr/local/bin/php /usr/local/opnsense/scripts/OPNsense/Podman/setup.php
    mkdir -p /var/run/podman /var/log/podman /var/db/containers
    chmod 0755 /var/run/podman
}

podman_service_start()
{
    podman_service_prestart
    echo -n "Starting ${name}... "
    echo "$(date '+%Y-%m-%dT%H:%M:%S%z') [info] Starting Podman UNIX socket daemon..." >> "${logfile}"
    
    # 1. Primary UNIX socket service (always active for local CLI & WebUI)
    /usr/sbin/daemon -f -p "${pidfile}" -o "${logfile}" "${podman_bin}" --log-level=info system service --time=0 unix:///var/run/podman/podman.sock </dev/null >/dev/null 2>&1
    sleep 1

    if [ ! -f "${pidfile}" ] || ! /bin/kill -0 "$(/bin/cat "${pidfile}")" 2>/dev/null; then
        echo "$(date '+%Y-%m-%dT%H:%M:%S%z') [error] Podman system service daemon failed to start." >> "${logfile}"
        echo "failed (see ${logfile})."
        return 1
    fi

    # 2. Optional TCP socket service (when TCP or TLS is enabled)
    if [ "${podman_service_tcp_enable}" = "YES" ] || [ "${podman_service_tls_enable}" = "YES" ]; then
        tcp_endpoint="tcp://${podman_service_listen_address}:${podman_service_listen_port}"
        echo "$(date '+%Y-%m-%dT%H:%M:%S%z') [info] Starting Podman TCP service on ${tcp_endpoint}..." >> "${logfile}"
        /usr/sbin/daemon -f -p "${tcppidfile}" -o "${logfile}" "${podman_bin}" --log-level=info system service --time=0 ${tls_flags} "${tcp_endpoint}" </dev/null >/dev/null 2>&1
    fi

    echo "$(date '+%Y-%m-%dT%H:%M:%S%z') [info] Podman system service daemon started (pid $(/bin/cat "${pidfile}"))." >> "${logfile}"
    echo "done."
    return 0
}

podman_service_stop()
{
    # Stop TCP daemon if running
    if [ -f "${tcppidfile}" ]; then
        tcppid=$(cat "${tcppidfile}" 2>/dev/null)
        if [ -n "${tcppid}" ] && kill -0 "${tcppid}" 2>/dev/null; then
            kill -TERM "${tcppid}" 2>/dev/null
            sleep 1
            if kill -0 "${tcppid}" 2>/dev/null; then
                kill -KILL "${tcppid}" 2>/dev/null
            fi
        fi
        rm -f "${tcppidfile}"
    fi

    # Stop Primary UNIX socket daemon
    if [ -f "${pidfile}" ]; then
        pid=$(cat "${pidfile}" 2>/dev/null)
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            echo -n "Stopping ${name}... "
            echo "$(date '+%Y-%m-%dT%H:%M:%S%z') [info] Stopping Podman system service daemon (pid ${pid})..." >> "${logfile}"
            kill -TERM "${pid}" 2>/dev/null
            sleep 1
            if kill -0 "${pid}" 2>/dev/null; then
                kill -KILL "${pid}" 2>/dev/null
            fi
            echo "$(date '+%Y-%m-%dT%H:%M:%S%z') [info] Podman system service daemon stopped." >> "${logfile}"
            echo "done."
        fi
        rm -f "${pidfile}" /var/run/podman/podman.sock
    fi
}

podman_service_status()
{
    if [ -f "${pidfile}" ]; then
        pid=$(cat "${pidfile}" 2>/dev/null)
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            echo "${name} is running as pid ${pid}."
            return 0
        fi
    fi
    echo "${name} is not running."
    return 1
}

start_cmd="podman_service_start"
stop_cmd="podman_service_stop"
status_cmd="podman_service_status"
extra_commands="status"

run_rc_command "$1"
