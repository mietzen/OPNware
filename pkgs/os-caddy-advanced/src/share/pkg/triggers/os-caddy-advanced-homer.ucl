# pkg trigger: sync Homer configuration when packages under /usr/local/opnsense/version change.
path: "/usr/local/opnsense/version"
cleanup: {
    type: lua
    sandbox: false
    script: <<EOS
if pkg.stat("/usr/local/opnsense/scripts/OPNsense/Homer/sync_caddy.php") then
    pkg.exec({"/usr/local/bin/php", "/usr/local/opnsense/scripts/OPNsense/Homer/sync_caddy.php"})
end
EOS
}
trigger: {
    type: lua
    sandbox: false
    script: <<EOS
if pkg.stat("/usr/local/opnsense/scripts/OPNsense/Homer/sync_caddy.php") then
    pkg.exec({"/usr/local/bin/php", "/usr/local/opnsense/scripts/OPNsense/Homer/sync_caddy.php"})
end
EOS
}
