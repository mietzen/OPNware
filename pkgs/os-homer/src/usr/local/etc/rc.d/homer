#!/bin/sh

# PROVIDE: homer
# REQUIRE: LOGIN DAEMON NETWORKING
# KEYWORD: shutdown
#
# OPNware os-homer — isolated caddy instance serving the Homer dashboard.
#
# The redistributed caddy package owns the fixed caddy rc script and
# /etc/rc.conf.d/caddy, so a second, isolated instance needs its own
# wrapper. This script drives the caddy binary directly with the homer
# instance's own config, state and admin settings. All tunables are
# homer_* rc vars, generated by OPNsense into /etc/rc.conf.d/homer.
#
# To enable:
#   echo 'homer_enable="YES"' >> /etc/rc.conf
#
# Note: the admin API is disabled, so applying a regenerated Caddyfile
# happens via restart (reload) rather than a hot caddy reload.

. /etc/rc.subr

name="homer"
rcvar="homer_enable"
desc="Homer dashboard served via an isolated caddy instance"

load_rc_config "${name}"

: ${homer_enable:="YES"}
: ${homer_caddy:="/usr/local/bin/caddy"}
: ${homer_config:="/usr/local/etc/os-homer/Caddyfile"}
: ${homer_adapter:="caddyfile"}
: ${homer_directory:="/var/db/os-homer/caddy"}
: ${homer_admin:="off"}
: ${homer_logdir:="/var/log/os-homer"}
: ${homer_logfile:="${homer_logdir}/homer.log"}
: ${homer_pidfile:="/var/run/os-homer/homer.pid"}
: ${homer_user:="www"}
: ${homer_group:="www"}

# Isolated instance: own XDG roots under ${homer_directory}, admin API off
# (CADDY_ADMIN=off), no envfile.
XDG_CONFIG_HOME="${homer_directory}"
XDG_DATA_HOME="${homer_directory}"
CADDY_ADMIN="${homer_admin}"
export XDG_CONFIG_HOME XDG_DATA_HOME CADDY_ADMIN

command="${homer_caddy}"
pidfile="${homer_pidfile}"

homer_flags="--config ${homer_config} --adapter ${homer_adapter} --envfile off"

homer_prestart()
{
    /usr/bin/install -d -m 755 -o "${homer_user}" -g "${homer_group}" "${homer_directory}"
    /usr/bin/install -d -m 755 -o "${homer_user}" -g "${homer_group}" "${homer_logdir}"
    /usr/bin/install -d -m 755 -o "${homer_user}" -g "${homer_group}" /var/run/os-homer
    if [ ! -f "${homer_logfile}" ]; then
        /usr/bin/install -m 644 -o "${homer_user}" -g "${homer_group}" /dev/null "${homer_logfile}"
    fi
}

homer_start()
{
    homer_prestart
    echo -n "Starting ${name}... "
    /usr/bin/su -m "${homer_user}" -c \
        "${homer_caddy} start ${homer_flags} --pidfile ${homer_pidfile}" \
        >> "${homer_logfile}" 2>&1
    if [ -f "${homer_pidfile}" ] && /bin/kill -0 "$(/bin/cat "${homer_pidfile}" 2>/dev/null)" 2>/dev/null; then
        echo "done."
        return 0
    fi
    echo "failed (see ${homer_logfile})."
    return 1
}

# The admin API is off, so "caddy reload" cannot reach the instance;
# applying a regenerated Caddyfile requires a restart.
homer_reload()
{
    ( run_rc_command stop )
    run_rc_command start
}

start_cmd="homer_start"
reload_cmd="homer_reload"
extra_commands="reload"

run_rc_command "$1"
