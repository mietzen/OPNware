{#
 # OPNware os-homer — generated Caddyfile for the isolated Homer instance.
 #
 # DO NOT EDIT THIS FILE — regenerated from the Homer settings. The address
 # must resolve to the effective URL: bare ":port" listens on all interfaces,
 # the LAN IP binds the configured address, "127.0.0.1:port" restricts the
 # instance to the loopback. When no LAN IP is configured (e.g. DHCP), the
 # port is left bare so the instance still starts.
 #
 # TLS rule: the internal CA can only mint a certificate for a hostname. With
 # "all interfaces" (port-only site) on_demand issues per-SNI. On a bound
 # interface a Server name is required — the site block then uses the
 # hostname so caddy issues a cert for it.
 #}
{%- set generalSettings = helpers.getNodeByTag('OPNsense.homer.general') -%}
{%- set port = generalSettings.Port|default("9443") -%}
{%- set tls = generalSettings.TlsEnabled|default("1") == "1" -%}
{%- set servername = generalSettings.ServerName|default("") -%}
{%- if generalSettings.Interface|default("all") == "localhost" -%}
{%-   set listen = "127.0.0.1:" ~ port -%}
{%- elif generalSettings.Interface|default("all") == "lan" -%}
{%-   set lanip = helpers.getNodeByTag('interfaces.lan.ipaddr') -%}
{%-   if lanip -%}
{%-     if ":" in lanip -%}
{%-       set listen = "[" ~ lanip ~ "]:" ~ port -%}
{%-     else -%}
{%-       set listen = lanip ~ ":" ~ port -%}
{%-     endif -%}
{%-   else -%}
{%-     set listen = ":" ~ port -%}
{%-   endif -%}
{%- else -%}
{%-   set listen = ":" ~ port -%}
{%- endif -%}
{
	auto_https disable_redirects
	admin off
	# Send caddy's own logs to syslog-ng via the unix socket; syslog-ng
	# rewrites them into /var/log/homer/homer_YYYYMMDD.log (RFC5424) which
	# the core Diagnostics log viewer reads. The rc script also captures
	# stdout/stderr into /var/log/homer/homer.log as a fallback.
	log {
		output net unixgram//var/run/homer/log.sock {
		}
		format json {
			time_format rfc3339
		}
	}
}

{% if tls and servername != '' %}
{{ servername }}:{{ port }} {
{% else %}
{{ listen }} {
{% endif %}
	root * /usr/local/www/homer
	file_server
{% if tls %}
	# The internal CA mints the certificate for the site's hostname. On a
	# port-only (all interfaces) site there is no hostname, so on_demand
	# issues per-SNI for whatever the client sends.
	tls internal {
		on_demand
	}
{% endif %}
}
