{# The caddy package default is root:wheel; the internal-CA trust install
   needs root. (An unprivileged run user would need the trust store managed.) #}
{% set generalSettings = helpers.getNodeByTag('OPNsense.homer.general') %}
{% if generalSettings.enabled|default("0") == "1" %}
homer_enable="YES"
homer_config="/usr/local/etc/os-homer/Caddyfile"
homer_adapter="caddyfile"
homer_directory="/var/db/os-homer/caddy"
homer_user="root"
homer_group="wheel"
homer_logdir="/var/log/homer"
{% else %}
homer_enable="NO"
{% endif %}
